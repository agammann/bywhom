{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "ByWhom — Follow the credit",
  "short_name": "ByWhom",
  "version": "0.1.1",
  "description": "Read explicit article credits when you ask, with exact visible and metadata evidence.",
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Read this page with ByWhom", "default_icon": "detective.png" },
  "side_panel": { "default_path": "panel.html" }
}
